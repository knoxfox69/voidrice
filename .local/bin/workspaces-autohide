#!/usr/bin/env python3
"""Hide the AWS WorkSpaces launcher window while a streaming session is open.

Listens to Hyprland's event socket. Whenever a window opens or closes, it
checks whether a DCV stream window exists and moves the launcher window:

  stream window appears  -> launcher goes to the hidden special:wsclient workspace
  stream window goes away -> launcher comes back to the active workspace, focused

Only acts on transitions, so toggling special:wsclient by hand (SUPER+SHIFT+A)
is never overridden mid-session.

Usage: workspaces-autohide [PID]
  If PID is given, the daemon exits once that process is gone.
"""

import json
import os
import socket
import subprocess
import sys

LAUNCHER_CLASS = "Workspacesclient"
STREAM_CLASSES = {"dcvviewer", "Dcvclientbin", "com.amazon.workspacesclient"}  # last = native Wayland app_id
HIDDEN_WS = "special:wsclient"


def hyprctl_json(*args):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True)
    return json.loads(out.stdout or "null")


def dispatch(lua):
    subprocess.run(["hyprctl", "dispatch", lua], capture_output=True)


def pid_alive(pid):
    if pid is None:
        return True
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def reconcile(prev_streaming):
    """Return the new streaming state, moving the launcher on transitions."""
    clients = hyprctl_json("clients") or []
    launchers = [c for c in clients if c.get("class") == LAUNCHER_CLASS]
    streaming = any(c.get("class") in STREAM_CLASSES for c in clients)

    if streaming == prev_streaming or not launchers:
        # No transition, or no launcher yet: keep the old state if there was
        # no launcher, so we act once it shows up.
        return streaming if launchers else prev_streaming

    for c in launchers:
        addr = c["address"]
        if streaming:
            dispatch(f'hl.dsp.window.move({{ workspace = "{HIDDEN_WS}", '
                     f'follow = false, window = "address:{addr}" }})')
        else:
            active = (hyprctl_json("activeworkspace") or {}).get("id", 1)
            dispatch(f'hl.dsp.window.move({{ workspace = "{active}", '
                     f'follow = false, window = "address:{addr}" }})')
            dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
    return streaming


def main():
    pid = int(sys.argv[1]) if len(sys.argv) > 1 else None
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not sig:
        sys.exit("HYPRLAND_INSTANCE_SIGNATURE not set; is Hyprland running?")
    path = f"{runtime}/hypr/{sig}/.socket2.sock"

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(path)
    sock.settimeout(5)  # wake up periodically to check PID

    # None = unknown, so the first reconcile with a launcher present always acts
    streaming = None
    streaming = reconcile(streaming)
    buf = b""
    while pid_alive(pid):
        try:
            data = sock.recv(4096)
        except socket.timeout:
            continue
        if not data:
            break  # Hyprland went away
        buf += data
        *lines, buf = buf.split(b"\n")
        if any(l.startswith((b"openwindow>>", b"closewindow>>")) for l in lines):
            streaming = reconcile(streaming)


if __name__ == "__main__":
    main()

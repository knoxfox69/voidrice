#!/bin/bash

# Launcher (login) window stays on X11; the DCV stream viewer runs natively on
# Wayland. Override with WORKSPACES_DCV_GDK_BACKEND=x11 to put the viewer back
# on XWayland.
export WORKSPACES_DCV_GDK_BACKEND="${WORKSPACES_DCV_GDK_BACKEND:-wayland}"

GDK_BACKEND=x11 /usr/bin/workspacesclient-wrapper "$@" &
WS_PID=$!

# Hide the launcher window while a session is streaming, and bring it back on
# disconnect. Exits by itself when the client does. SUPER+SHIFT+A still
# toggles the hidden launcher manually.
"$HOME/.local/bin/workspaces-autohide" "$WS_PID" &

wait "$WS_PID"
